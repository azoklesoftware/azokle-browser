    <string name="privacy_policy_sub">Zero-knowledge encryption commitment</string>
    <string name="privacy_policy_content">Azokle is engineered on a zero-knowledge architecture. We do not log your searches, track your IP address, store browser fingerprints, or sell user telemetry. All history and session cookies remain encrypted on your device and can be permanently incinerated with a single tap.</string>
    <string name="terms_service">Terms of Service</string>
    <string name="terms_service_sub">Usage terms and privacy guarantee</string>
    <string name="terms_service_content">Azokle Search and Privacy Browser is provided free of charge under a privacy-first guarantee. By using Azokle, you agree not to use the service for malicious activities or automated abuse.</string>
