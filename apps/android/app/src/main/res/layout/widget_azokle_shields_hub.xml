<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shields_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_shields_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row: Shield Emblem + Brand Hierarchy + Status Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Shield Emblem Badge Container -->
        <FrameLayout
            android:id="@+id/widget_shield_badge_container"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_shield_badge_bg_dark">

            <ImageView
                android:id="@+id/widget_shield_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Shield"
                android:src="@drawable/ic_widget_shield"
                android:tint="#22C55E" />
        </FrameLayout>

        <!-- Brand Hierarchy -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_shield_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Azokle Shield"
                android:textColor="#F3F3F3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_shield_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Real-time Privacy Protection"
                android:textColor="#A0A0A0"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Protected Status Pill -->
        <LinearLayout
            android:id="@+id/widget_shield_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_status_pill_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/widget_shield_status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="Status Dot"
                android:src="@drawable/widget_dot_emerald" />

            <TextView
                android:id="@+id/widget_shield_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="PROTECTED"
                android:textColor="#22C55E"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2x2 Grid of 4 Privacy Metric Cards (Ad Blocker, Tracker Blocker, Data Saved, Time Saved) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: Ads Blocked & Trackers Blocked -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Card 1: Ads Blocked -->
            <LinearLayout
                android:id="@+id/widget_card_ads"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_metric_card_bg_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/widget_metric_ads"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="#38BDF8"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_label_ads"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Ads Blocked"
                    android:textColor="#A0A0A0"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Card 2: Trackers Blocked -->
            <LinearLayout
                android:id="@+id/widget_card_trackers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_metric_card_bg_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/widget_metric_trackers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="#F97316"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_label_trackers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Trackers Blocked"
                    android:textColor="#A0A0A0"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Data Saved & Time Saved -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Card 3: Data Saved -->
            <LinearLayout
                android:id="@+id/widget_card_bandwidth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_metric_card_bg_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/widget_metric_bandwidth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0 KB"
                    android:textColor="#A855F7"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_label_bandwidth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Data Saved"
                    android:textColor="#A0A0A0"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Card 4: Time Saved -->
            <LinearLayout
                android:id="@+id/widget_card_time"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_metric_card_bg_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/widget_metric_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0s"
                    android:textColor="#22C55E"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_label_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Time Saved"
                    android:textColor="#A0A0A0"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
