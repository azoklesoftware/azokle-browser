<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tor_root"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:background="@drawable/widget_tor_bg_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="5dp"
    android:paddingEnd="8dp"
    android:paddingBottom="5dp">

    <!-- Tor Onion Emblem Container -->
    <FrameLayout
        android:id="@+id/widget_tor_brand_container"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_tor_emblem_bg_dark">

        <ImageView
            android:id="@+id/widget_tor_emblem_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="Tor Anonymous Search"
            android:src="@drawable/ic_tor" />
    </FrameLayout>

    <!-- Search Prompt Text -->
    <TextView
        android:id="@+id/widget_tor_search_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="Search with Tor"
        android:textColor="#F3E8FF"
        android:textSize="14sp" />

    <!-- Subtle Architectural Divider -->
    <ImageView
        android:id="@+id/widget_tor_divider"
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_marginEnd="6dp"
        android:background="#33A855F7"
        android:contentDescription="Divider" />

    <!-- Voice Search Action Button -->
    <FrameLayout
        android:id="@+id/widget_tor_btn_voice"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_tor_chip_bg_dark">

        <ImageView
            android:id="@+id/widget_tor_voice_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="Tor Voice Search"
            android:src="@drawable/ic_widget_mic"
            android:tint="#F3E8FF" />
    </FrameLayout>

</LinearLayout>
