{
  "manifest_version": 2,
  "name": "Azokle Shield Core",
  "version": "6.0",
  "description": "Native Sovereign Ad Blocker, Tracker Annihilator, Anti-Fingerprinting, Dynamic Cosmetic Engine & Tor SOCKS5 Proxy",
  "browser_specific_settings": {
    "gecko": {
      "id": "shield@azokle.com",
      "strict_min_version": "68.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.azokle.com/*",
        "*://azokle.com/*",
        "*://*.cloudflare.com/*",
        "*://cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*",
        "*://challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://*.recaptcha.net/*",
        "*://*.browserbench.org/*",
        "*://browserbench.org/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": [
        "scriptlets/defuser.js",
        "scriptlets/fingerprint_shield.js",
        "scriptlets/autoconsent.js",
        "content.js"
      ],
      "css": ["cosmetic.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "web_accessible_resources": [
    "surrogates/*"
  ],
  "incognito": "spanning",
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "proxy",
    "storage",
    "nativeMessaging",
    "geckoViewAddons"
  ]
}
