# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.rs text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.java text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.xml text eol=lf
gradlew text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.aar binary
*.so binary
*.dylib binary
*.dll binary
*.jks binary
*.keystore binary
*.tar.gz binary
*.zip binary
