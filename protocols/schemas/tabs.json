{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TabDomainSchema",
  "definitions": {
    "TabSession": {
      "type": "object",
      "required": ["id", "url", "title", "is_private", "is_tor", "is_sleeping", "last_accessed_at", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "is_private": { "type": "boolean" },
        "is_tor": { "type": "boolean" },
        "is_sleeping": { "type": "boolean" },
        "group_id": { "type": ["string", "null"] },
        "group_title": { "type": ["string", "null"] },
        "last_accessed_at": { "type": "integer" },
        "created_at": { "type": "integer" }
      }
    },
    "TabOpenCommand": {
      "type": "object",
      "required": ["url", "title", "is_private", "is_tor"],
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "is_private": { "type": "boolean" },
        "is_tor": { "type": "boolean" },
        "group_id": { "type": ["string", "null"] },
        "group_title": { "type": ["string", "null"] }
      }
    }
  }
}
