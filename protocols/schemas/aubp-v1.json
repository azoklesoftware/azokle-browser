{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AzokleUniversalBrowserProtocolV1",
  "type": "object",
  "required": ["version", "message_id", "timestamp_ms", "source", "target", "payload"],
  "properties": {
    "version": {
      "type": "object",
      "required": ["major", "minor", "patch"],
      "properties": {
        "major": { "type": "integer", "minimum": 1 },
        "minor": { "type": "integer", "minimum": 0 },
        "patch": { "type": "integer", "minimum": 0 }
      }
    },
    "message_id": {
      "type": "string",
      "pattern": "^msg_[0-9]+_[0-9]+$"
    },
    "correlation_id": {
      "type": ["string", "null"]
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "string",
      "enum": ["RustCore", "GeckoEngine", "AndroidUI", "IosUI", "DesktopUI", "ExtensionBridge"]
    },
    "target": {
      "type": "string",
      "enum": ["RustCore", "GeckoEngine", "AndroidUI", "IosUI", "DesktopUI", "ExtensionBridge"]
    },
    "payload": {
      "type": "object"
    }
  }
}
